<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:gravity="center"
    android:padding="24dp">

    <!-- Tarjeta del Diálogo Modal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Icono Papelera -->
        <TextView
            android:id="@+id/tvIconoPapeleraEvento"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="#FDE8E8"
            android:gravity="center"
            android:text="🗑"
            android:textColor="#C62828"
            android:textSize="24sp" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloEliminarEvento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="¿Eliminar este evento?"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Mensaje de Advertencia -->
        <TextView
            android:id="@+id/tvMensajeEliminarEvento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Esta acción no se puede deshacer. Se\neliminará &quot;Excursión al Planetario&quot;."
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Botón 1: Sí, eliminar evento -->
        <Button
            android:id="@+id/btnConfirmarEliminarEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#B71C1C"
            android:padding="12dp"
            android:text="Sí, eliminar evento"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Botón 2: Cancelar -->
        <Button
            android:id="@+id/btnCancelarEliminarEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FFFFFF"
            android:padding="12dp"
            android:text="Cancelar"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</RelativeLayout>

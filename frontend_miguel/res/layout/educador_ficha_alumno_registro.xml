<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Barra Superior: Menú y Perfil -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="12dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Menú" />

            <ImageView
                android:id="@+id/btnPerfil"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Perfil" />
        </RelativeLayout>

        <!-- Cabecera Navegación: Volver a La Ranita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:color/white"
            android:elevation="1dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="‹ Volver a La Ranita"
                android:textColor="#9EC3B4"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ficha de alumno"
                android:textColor="#757575"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Tarjeta Principal del Registro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Info del Alumno -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvInicialAlumno"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#B2DFDB"
                    android:gravity="center"
                    android:text="L"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreAlumno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lucas García"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registro Diario · Hoy"
                        android:textColor="#757575"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="#E0E0E0" />

            <!-- SECCIÓN 1: SUEÑO / SIESTA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUEÑO / SIESTA"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F5F5F5"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHoraInicioSiesta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inicio: 12:30h"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstadoSiesta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En curso..."
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPararSiesta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:backgroundTint="#E5989B"
                    android:text="⏱ 00:45 · Parar"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </RelativeLayout>

            <!-- SECCIÓN 2: ALIMENTACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ALIMENTACIÓN"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Menú:"
                android:textColor="#757575"
                android:textSize="12sp" />

            <!-- Opciones Menú -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMenuBiberon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#A3C9A8"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🍼 Biberón"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMenuTriturada"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🥣 Triturada"
                    android:textColor="#616161"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnMenuSolida"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🍎 Sólida"
                    android:textColor="#616161"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Medida (ml):"
                android:textColor="#757575"
                android:textSize="12sp" />

            <!-- Mililitros Biberón -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="120 ml"
                    android:textColor="#616161"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#A3C9A8"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="180 ml"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="210 ml"
                    android:textColor="#616161"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="240 ml"
                    android:textColor="#616161"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tomado:"
                android:textColor="#757575"
                android:textSize="12sp" />

            <!-- Porcentaje Tomado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="0%"
                    android:textColor="#616161"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="25%"
                    android:textColor="#616161"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="50%"
                    android:textColor="#616161"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="75%"
                    android:textColor="#616161"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#A3C9A8"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="100%"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SECCIÓN 3: CAMBIOS DE PAÑAL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CAMBIOS DE PAÑAL"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Contador Pipí -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="💦 Pipí (veces):"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="0"
                    android:textColor="#616161" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="1"
                    android:textColor="#616161" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#A3C9A8"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="2"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="3"
                    android:textColor="#616161" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="4+"
                    android:textColor="#616161" />
            </LinearLayout>

            <!-- Contador Caca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="💩 Caca (veces):"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="0"
                    android:textColor="#616161" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#A3C9A8"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="1"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="2"
                    android:textColor="#616161" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#F0F0F0"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="3+"
                    android:textColor="#616161" />

                <!-- Espacio sobrante para alinear con la fila de arriba de 5 opciones -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- SECCIÓN 4: OBSERVACIONES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="OBSERVACIONES"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="6dp"
                android:background="#FAFAFA"
                android:gravity="top|start"
                android:hint="Añade observaciones sobre la jornada..."
                android:padding="10dp"
                android:text="Se ha tomado todo el biberón con muchas ganas. 2 cambios de pañal de pis y 1 de caca."
                android:textColor="#000000"
                android:textSize="12sp" />

            <!-- BOTÓN GUARDAR REGISTRO -->
            <Button
                android:id="@+id/btnGuardarRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#A3C9A8"
                android:padding="14dp"
                android:text="Guardar registro"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>

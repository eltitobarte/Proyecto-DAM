<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ====== Tipografías ====== -->
    <style name="TextAppearance.GestionGuarderia.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/tertiary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.GestionGuarderia.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.GestionGuarderia.Link" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/tertiary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.GestionGuarderia.Footer" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ====== Botón principal ====== -->
    <style name="Widget.GestionGuarderia.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/tertiary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- ====== Tarjetas ====== -->
    <style name="Widget.GestionGuarderia.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

</resources>

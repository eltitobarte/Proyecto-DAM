<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Barra Superior: Menú y Perfil -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:padding="12dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Menú" />

            <ImageView
                android:id="@+id/btnPerfil"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Perfil" />
        </RelativeLayout>

        <!-- Tarjeta del Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@android:color/white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo aviso"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Campo: Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Título"
                android:textColor="#757575"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etTituloAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FAFAFA"
                android:hint="Ej. Excursión al Planetario de Madrid"
                android:padding="12dp"
                android:text="Excursión al Planetario de Madrid"
                android:textColor="#000000"
                android:textSize="14sp" />

            <!-- Campo: Nivel de aviso -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nivel de aviso"
                android:textColor="#757575"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNivelRojo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#FAFAFA"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🔴 Rojo · Crítico"
                    android:textColor="#616161"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnNivelAmarillo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.2"
                    android:background="#A3C9A8"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🟡 Amarillo · Aviso"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNivelAzul"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.2"
                    android:background="#FAFAFA"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="🔵 Azul · Recordatorio"
                    android:textColor="#616161"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Campo: Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Descripción"
                android:textColor="#757575"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDescripcionAviso"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="#FAFAFA"
                android:gravity="top|start"
                android:hint="Escribe el contenido del aviso..."
                android:padding="12dp"
                android:text="La excursión será el 24 de septiembre de 09:00 a 15:00. Autorización firmada por las familias antes del 22."
                android:textColor="#000000"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Botón 1: Publicar aviso -->
        <Button
            android:id="@+id/btnPublicarAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#A3C9A8"
            android:padding="14dp"
            android:text="Publicar aviso"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Botón 2: Cancelar -->
        <Button
            android:id="@+id/btnCancelarAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#EFEFEF"
            android:padding="14dp"
            android:text="Cancelar"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>

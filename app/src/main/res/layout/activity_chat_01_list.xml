<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de chat: listado de hijos.

    Estructura:
      ScrollView
        └─ LinearLayout vertical
             ├─ barra superior (menú, título y perfil)
             ├─ título "Mis babies:"
             └─ una fila por hijo (avatar, nombre, aviso y flecha)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back_screen"
    android:fillViewport="true"
    tools:context=".PMTChatListActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ===================== 1. BARRA SUPERIOR ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_app_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/ivMenu"
                android:contentDescription="@string/cd_menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu_24"
                app:tint="@color/tile_dark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/chat_title"
                android:textColor="@color/on_surface"
                android:textSize="22sp" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:id="@+id/ivProfile"
                android:contentDescription="@string/cd_profile"
                android:padding="12dp"
                android:src="@drawable/ic_person_24"
                app:tint="@color/tile_dark" />
        </LinearLayout>

        <!-- ===================== 2. TÍTULO ===================== -->
        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="85dp"
            android:layout_marginEnd="22dp"
            android:text="@string/chat_heading"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Lista de conversaciones: la rellena el adaptador, ya no hay filas escritas a mano -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaChats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

    </LinearLayout>
</ScrollView>

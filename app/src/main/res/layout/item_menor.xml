<?xml version="1.0" encoding="utf-8"?>
<!--
    Una fila del listado de menores.
    Lleva el avatar, el nombre y la flecha de entrar. Se usa desde el adaptador
    (MenoresAdapter), que la rellena con cada niño de la lista.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="22dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_person_24"
            app:tint="@color/avatar_text" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/on_surface"
            android:textSize="16sp" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/cd_open_child"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="@color/tile_dark" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="22dp"
        android:background="@color/divider" />
</LinearLayout>

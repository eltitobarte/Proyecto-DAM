<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla para editar la ficha médica del menor.

    Estructura:
      ScrollView
        └─ LinearLayout vertical
             ├─ barra superior (menú, título y perfil)
             ├─ tarjeta con las categorías
             ├─ tarjeta con el detalle de la etiqueta
             └─ botones de guardar, eliminar y cancelar
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ===================== 1. BARRA SUPERIOR ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_app_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu_24"
                app:tint="@color/tile_dark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/health_title"
                android:textColor="@color/on_surface"
                android:textSize="22sp" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_profile"
                android:padding="12dp"
                android:src="@drawable/ic_person_24"
                app:tint="@color/tile_dark" />
        </LinearLayout>

        <!-- ===================== 2. CATEGORÍA ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:text="@string/health_category"
                    android:textColor="@color/tertiary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Alergia alimentaria (seleccionada) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_radio_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/health_category_1"
                        android:textColor="@color/tertiary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Intolerancia -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_radio_off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/health_category_2"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Medicación diaria -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_radio_off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/health_category_3"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Observación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_radio_off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/health_category_4"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== 3. DETALLE ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:text="@string/health_detail_title"
                    android:textColor="@color/tertiary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/health_ingredient_label"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etIngredient"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field_box"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/health_ingredient_value"
                    android:textColor="@color/tertiary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/health_protocol_label"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etProtocol"
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field_box"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:text="@string/health_protocol_value"
                    android:textColor="@color/grey"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== 4. BOTONES ===================== -->
        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:text="@string/health_save"
            android:textColor="@color/tertiary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="@string/health_delete"
            android:textColor="@color/logout_red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="36dp"
            android:gravity="center"
            android:text="@string/health_cancel"
            android:textColor="@color/tertiary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>

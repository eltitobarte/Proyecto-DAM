<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla para cambiar la contraseña.

    Estructura:
      ScrollView
        └─ LinearLayout vertical
             ├─ barra superior (menú, título y perfil)
             ├─ tarjeta con el formulario
             ├─ tarjeta con los requisitos de seguridad
             └─ botón de actualizar, aviso y cancelar
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- ===================== 1. BARRA SUPERIOR ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_app_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu_24"
                app:tint="@color/tile_dark" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/password_title"
                android:textColor="@color/on_surface"
                android:textSize="22sp" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_profile"
                android:padding="12dp"
                android:src="@drawable/ic_person_24"
                app:tint="@color/tile_dark" />
        </LinearLayout>

        <!-- ===================== 2. FORMULARIO ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:text="@string/password_form"
                    android:textColor="@color/tertiary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Contraseña actual -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/password_current"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/etCurrent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:text="@string/password_current_value"
                        android:textColor="@color/tertiary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/btnShow"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/password_show"
                        android:textColor="@color/grey"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Nueva contraseña -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/password_new"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etNew"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field_box"
                    android:hint="@string/password_new_hint"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/tertiary"
                    android:textColorHint="#FF9E9E9E"
                    android:textSize="13sp" />

                <!-- Confirmar contraseña -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/password_confirm"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field_box"
                    android:hint="@string/password_confirm_hint"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/tertiary"
                    android:textColorHint="#FF9E9E9E"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== 3. REQUISITOS ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRequirements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:text="@string/password_requirements"
                    android:textColor="@color/tertiary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Mínimo 8 caracteres -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_check_on"
                        android:gravity="center"
                        android:text="@string/password_check"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/password_req_1"
                        android:textColor="@color/tertiary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Al menos 1 número -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_check_on"
                        android:gravity="center"
                        android:text="@string/password_check"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/password_req_2"
                        android:textColor="@color/tertiary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Al menos 1 mayúscula -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_check_off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/password_req_3"
                        android:textColor="@color/grey"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Al menos 1 símbolo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_check_off" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/password_req_4"
                        android:textColor="@color/grey"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/password_requirements_note"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== 4. BOTONES ===================== -->
        <TextView
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_button_disabled"
            android:gravity="center"
            android:text="@string/password_update"
            android:textColor="#FF737373"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:text="@string/password_update_note"
            android:textColor="@color/grey"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="36dp"
            android:gravity="center"
            android:text="@string/password_cancel"
            android:textColor="@color/tertiary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
